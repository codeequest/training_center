# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/centre_formation?schema=public"

# --- Serveur ---
PORT=4000
NODE_ENV=development

# --- Sécurité / JWT ---
# Générer une valeur aléatoire : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# --- CORS : origine du frontend Next.js ---
CORS_ORIGIN="http://localhost:3000"

# --- Uploads (supports de cours) ---
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=25

# --- Email transactionnel ---
# Si SMTP_HOST est vide, les emails sont simplement journalisés dans la console.
# Gmail : le port 587 (STARTTLS) est le seul à utiliser, SMTP_SECURE reste false.
# SMTP_PASSWORD n'est PAS le mot de passe du compte Google mais un « mot de passe
# d'application » de 16 caractères, à créer sur https://myaccount.google.com/apppasswords
# (nécessite la validation en deux étapes activée sur le compte).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="codeequest@gmail.com"
SMTP_PASSWORD=""
MAIL_FROM="Centre de Formation <codeequest@gmail.com>"
CONTACT_INBOX="contact@centre-formation.tn"

# --- Compte administrateur créé par le seed ---
ADMIN_EMAIL="admin@centre-formation.tn"
ADMIN_PASSWORD="Admin123!"
